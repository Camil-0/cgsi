# Variables de entorno — B.15. Ningún valor real vive en este archivo.
# Copiar a `.env.local` y llenar. `src/lib/env.ts` valida con Zod y falla si falta una obligatoria.

# --- Públicas (llegan al cliente) ---
# URL canónica del sitio. {PENDIENTE: dominio propio}; en desarrollo, http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Número de WhatsApp en formato wa.me: solo dígitos. Obligatoria desde F4.
NEXT_PUBLIC_WHATSAPP_NUMERO=
# Enlace del evento de Cal.com, p. ej. cgsi/diagnostico. Obligatoria desde F4.
NEXT_PUBLIC_CAL_LINK=

# NEXT_PUBLIC_APP_VERSION y NEXT_PUBLIC_BUILD_DATE no se declaran aquí:
# next.config.ts las inyecta desde package.json y desde la fecha del build.

# --- Privadas (nunca llegan al cliente) ---
# Secreto del webhook de Cal.com (firma x-cal-signature-256). Obligatoria desde F4.
CAL_WEBHOOK_SECRET=

# Firebase Admin SDK (solo servidor). Obligatorias desde F4.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Adaptador de mensajería: evolution | cloud | ninguno (por defecto, ninguno)
MENSAJERIA_PROVEEDOR=
# Solo si MENSAJERIA_PROVEEDOR=evolution. Número secundario, nunca el comercial.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=
# Teléfono personal del fundador, solo dígitos.
NOTIFICACIONES_DESTINO=

# Versión de la política de tratamiento de datos que se guarda en el consentimiento.
POLITICA_VERSION=

# Verificación de buscadores. Obligatorias desde F5.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
